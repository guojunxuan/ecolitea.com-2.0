# Database connection string
DATABASE_URI=mongodb://127.0.0.1/your-database-name
MONGODB_URI=mongodb://127.0.0.1/your-database-name # Compose-only; mapped to DATABASE_URI
IMAGE_TAG=latest # Compose-only deployment selector

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 (S3-compatible); the single public origin for originals and render-time media delivery
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.example.com

# Cloudflare Turnstile (request a quote). Use separate keys per environment.
# Local/test: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Random string used to hash client IPs for rate limiting (never stores raw IPs)
QUOTE_IP_HASH_SALT=YOUR_RANDOM_SALT_HERE
# Development only: extra hostnames allowed to load the dev server (comma-separated),
# e.g. a hostname mapped to 127.0.0.1 in /etc/hosts for a domain-bound Turnstile widget.
# NEXT_DEV_ALLOWED_ORIGINS=quote-dev.example.com
