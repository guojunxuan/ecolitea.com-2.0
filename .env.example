# Required (server runtime)
# Local Payload connection; Compose maps MONGODB_URI below to DATABASE_URI.
DATABASE_URI=mongodb://127.0.0.1:27017/your-database-name
# Signs authentication tokens and encrypts integration credentials. Keep stable.
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Canonical public origin for CORS, links and revalidation. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE
# R2 originals and render-time media delivery; use separate resources per environment.
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.example.com

# Optional features (server runtime)
# Request-a-quote protection; configure together with the public site key below.
TURNSTILE_SECRET_KEY=
QUOTE_IP_HASH_SALT=
# Enable on exactly one long-running application instance.
JOBS_AUTORUN=false
# Required for background cache invalidation, including scheduled publication.
REVALIDATE_SECRET=
# Google integrations are configured in Site Settings → Integrations.

# Optional SMTP override (server runtime; restart/recreate after changes)
# When SMTP_HOST is non-empty, this entire group overrides Integrations → Email.
# No values are inherited from Site Settings. Leave SMTP_HOST empty to use settings.
SMTP_HOST=
# Defaults to 587; integer from 1 to 65535.
SMTP_PORT=587
# none | starttls | tls; defaults to starttls. Use none only for local Mailpit.
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# Public (server runtime; passed to the quote form, no rebuild required)
# Local/test site key: 1x00000000000000000000AA
# Matching test secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Deployment-only (Compose, image)
# Use the container-network hostname and credentials matching the MongoDB service.
MONGODB_URI=mongodb://your-mongo-user:your-mongo-password@mongodb:27017/your-database-name?authSource=admin
MONGO_INITDB_ROOT_USERNAME=your-mongo-user
MONGO_INITDB_ROOT_PASSWORD=your-mongo-password
ECOLITEA_IMAGE=ghcr.io/ecolitea/ecolitea
IMAGE_TAG=latest

# Development & test only
# Automated tests must use local storage or isolated placeholders.
DISABLE_R2_STORAGE=false
# Comma-separated additional hostnames allowed by the dev server.
NEXT_DEV_ALLOWED_ORIGINS=

# Platform-provided (leave unset outside the hosting platform)
# VERCEL_PROJECT_PRODUCTION_URL=

# One-off data repair scripts (leave unset during normal operation)
# PRODUCT_DETAIL_SPECS_APPROVED_FINGERPRINT=
# PRODUCT_OPTION_IMAGE_APPROVED_FINGERPRINT=
# PRODUCT_OPTION_IMAGE_DEMO_REPAIR=false
# PRODUCT_OPTION_IMAGE_BACKUP_PATH=
